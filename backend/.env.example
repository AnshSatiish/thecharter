# Leave unset to use a local SQLite file (./charter.db). For PostgreSQL + PostGIS, run `docker compose up -d` at the repo root.
DATABASE_URL=postgresql+psycopg://charter:charter@localhost:5432/charter

# development | production. Production refuses to start without ADMIN_TOKEN.
ENV=development
ADMIN_TOKEN=dev-admin-token

CORS_ORIGINS=http://localhost:5173,http://localhost:3031,http://localhost:8080
