# Leave unset to use a local SQLite file (./charter.db). For PostgreSQL + PostGIS, run `docker compose up -d` at the repo root.
DATABASE_URL=postgresql+psycopg://charter:charter@localhost:5432/charter

# development | production. Production refuses to start without ADMIN_TOKEN.
ENV=development
ADMIN_TOKEN=dev-admin-token

CORS_ORIGINS=http://localhost:5173,http://localhost:3031,http://localhost:8080

# Uploaded photographs and PDFs. Unset: <repo>/data/uploads (git-ignored). Served at /files.
# UPLOAD_DIR=../data/uploads
MAX_IMAGE_MB=25
MAX_PDF_MB=50

# Semantic search. The sentence model is open source and runs on this machine: no API key, no cost.
# It is downloaded once (about 66 MB) into EMBEDDING_CACHE_DIR. Set SEMANTIC_SEARCH=false for keyword search only.
SEMANTIC_SEARCH=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=~/.cache/charter-models
# SEMANTIC_MIN_SCORE=0.575
# AI summarization (needs PyTorch and Transformers, see requirements.txt). false: extractive baseline only.
AI_SUMMARY=true
# SUMMARY_MODEL=sshleifer/distilbart-cnn-6-6
