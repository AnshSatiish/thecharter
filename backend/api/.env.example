# Leave unset to use a local SQLite file (./charter.db). For PostgreSQL + PostGIS, run `docker compose up -d` at the repo root.
# DATABASE_URL=postgresql+psycopg://charter:charter@localhost:5432/charter

# development | production | test. Production refuses to start without ADMIN_TOKEN.
ENV=development
ADMIN_TOKEN=dev-admin-token

CORS_ORIGINS=http://localhost:5173,http://localhost:3031,http://localhost:8080

# Uploaded photographs and PDFs. Unset: backend/data/uploads (git-ignored). Served at /files.
# UPLOAD_DIR=../data/uploads
MAX_IMAGE_MB=25
MAX_PDF_MB=50

# Semantic search. The sentence model is open source and runs on this machine: no API key, no cost.
# It is downloaded once (about 66 MB) into EMBEDDING_CACHE_DIR. Set SEMANTIC_SEARCH=false for keyword search only.
SEMANTIC_SEARCH=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=~/.cache/charter-models
# SEMANTIC_MIN_SCORE=0.575
# SEMANTIC_RELATIVE_CUT=0.95
# EMBEDDING_THREADS=          # unset: all cores; the load test used 1

# Database connection pool (a full pool answers 503 busy after DB_POOL_TIMEOUT seconds)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=15
# DB_POOL_TIMEOUT=5

# Install and start Ollama, then run `ollama pull llama3.2:3b`.
# If Ollama or the model is unavailable, requested summaries use the TF-IDF fallback.
AI_SUMMARY=true
SUMMARY_MODEL=llama3.2:3b
SUMMARY_OLLAMA_URL=http://localhost:11434
SUMMARY_TIMEOUT_SECONDS=300
SUMMARY_MAX_NEW_TOKENS=160
