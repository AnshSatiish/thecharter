<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Supabase database schema" id="supabase-schema"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="auth_users" value="&lt;b&gt;auth.users (Supabase-managed)&lt;/b&gt;&lt;hr/&gt;PK  id (UUID)&lt;br/&gt;Managed by Supabase Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="45.0" y="306.0" width="270.0" height="108.0" as="geometry" /></mxCell><mxCell id="admins" value="&lt;b&gt;public.admins&lt;/b&gt;&lt;hr/&gt;PK / FK  user_id → auth.users.id&lt;br/&gt;added_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="450.0" y="378.0" width="270.0" height="112.5" as="geometry" /></mxCell><mxCell id="projects_s" value="&lt;b&gt;public.projects&lt;/b&gt;&lt;hr/&gt;PK  id (bigint identity)&lt;br/&gt;title, description, category&lt;br/&gt;location_name, lat, lng, date&lt;br/&gt;keywords[], sdgs[], images[], captions[]&lt;br/&gt;summary, author_name, author_affiliation&lt;br/&gt;author_profession, author_role, author_website&lt;br/&gt;document_url, document_name, document_size&lt;br/&gt;verified, created_at&lt;br/&gt;FK  created_by → auth.users.id (nullable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="450.0" y="90.0" width="360.0" height="238.5" as="geometry" /></mxCell><mxCell id="events" value="&lt;b&gt;public.events&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;title, kind, starts_on, ends_on&lt;br/&gt;location_name, online, url&lt;br/&gt;description, created_at&lt;br/&gt;FK  created_by → auth.users.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="917.9999999999999" y="368.99999999999994" width="270.0" height="157.5" as="geometry" /></mxCell><mxCell id="sponsors" value="&lt;b&gt;public.sponsors&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;name, tier, url, logo_url&lt;br/&gt;blurb, sort, created_at&lt;br/&gt;FK  created_by → auth.users.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="917.9999999999999" y="135.0" width="270.0" height="157.5" as="geometry" /></mxCell><mxCell id="e0" value="1 → 0/1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="auth_users" target="admins"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="auth_users" target="projects_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="auth_users" target="events"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="auth_users" target="sponsors"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br/&gt;• Tables defined across supabase/schema.sql and supabase/pages.sql: projects, admins, events, sponsors. auth.users is managed by Supabase Auth.&lt;br/&gt;• admins controls write permissions through public.is_admin() and RLS; projects/events/sponsors are not FK-related to admins.&lt;br/&gt;• Storage bucket project-files stores images and PDFs; it is a Storage resource, not a relational table.&lt;br/&gt;• Author details are flattened into public.projects; there is no separate Supabase authors table. No users/messages/contacts tables are defined in these SQL files." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#b69b4b;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1120" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>