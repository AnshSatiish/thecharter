<mxfile host="app.diagrams.net"><diagram name="AI capability architecture" id="AI-capability-architecture">
  <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="980" pageHeight="640">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="g1" value="Indexing: runs when a project or PDF is saved" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#8a8a86;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#52514e;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="940" height="250" as="geometry"/></mxCell>
      <mxCell id="g2" value="Query: runs on every search" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#8a8a86;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#52514e;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="940" height="320" as="geometry"/></mxCell>
      <mxCell id="upload" value="&lt;b&gt;Admin upload&lt;/b&gt;&lt;br&gt;project text, narration,&lt;br&gt;PDF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f4f1;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="extract" value="&lt;b&gt;Text extraction&lt;/b&gt;&lt;br&gt;pypdf, per page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="70" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="chunk" value="&lt;b&gt;Passage chunking&lt;/b&gt;&lt;br&gt;whole sentences,&lt;br&gt;40 words, 1 overlap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="150" height="64" as="geometry"/></mxCell>
      <mxCell id="embed" value="&lt;b&gt;Sentence model&lt;/b&gt;&lt;br&gt;bge-small-en-v1.5,&lt;br&gt;ONNX, 384 dimensions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="70" width="165" height="64" as="geometry"/></mxCell>
      <mxCell id="fold" value="&lt;b&gt;Keyword text&lt;/b&gt;&lt;br&gt;accent folding,&lt;br&gt;field weights A to D" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;search_chunks:&lt;br&gt;vector(384), HNSW&lt;br&gt;projects.search_tsv:&lt;br&gt;tsvector, GIN" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#e9f7f1;strokeColor=#1baf7a;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="160" height="130" as="geometry"/></mxCell>
      <mxCell id="ui" value="&lt;b&gt;3D globe site&lt;/b&gt;&lt;br&gt;search box:&lt;br&gt;Keywords / By meaning" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f4f1;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="api" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;GET /api/projects/search&lt;br&gt;mode, limit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="400" width="150" height="64" as="geometry"/></mxCell>
      <mxCell id="qembed" value="&lt;b&gt;Embed the query&lt;/b&gt;&lt;br&gt;same sentence model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="160" height="60" as="geometry"/></mxCell>
      <mxCell id="vec" value="&lt;b&gt;Vector search&lt;/b&gt;&lt;br&gt;pgvector, cosine,&lt;br&gt;best passage per project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="160" height="60" as="geometry"/></mxCell>
      <mxCell id="cut" value="&lt;b&gt;Relevance cut-off&lt;/b&gt;&lt;br&gt;0.575 and 95% of&lt;br&gt;the top score" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="340" width="145" height="60" as="geometry"/></mxCell>
