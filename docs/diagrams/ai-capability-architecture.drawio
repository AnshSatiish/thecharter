      <mxCell id="e20" value="Keywords mode, or fallback: any word" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.24;" edge="1" parent="1" source="fts" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
