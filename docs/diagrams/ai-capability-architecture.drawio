      <mxCell id="e2" value="" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="chunk" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="vectors" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="embed" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="extract" target="fold"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5" value="tsvector" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="fold" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e6" value="passages" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;dashed=1;" edge="1" parent="1" source="db" target="vec"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="ui" target="dback"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e8" value="yes" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="dback" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
