      <mxCell id="e10" value="By meaning" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="api" target="qembed"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e11" value="both modes" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="api" target="fts"><mxGeometry relative="1" as="geometry"/></mxCell>
