<mxfile host="app.diagrams.net"><diagram name="AI capability architecture" id="AI-capability-architecture">
  <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="800">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="g1" value="Indexing: runs when a project or PDF is saved" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#8a8a86;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#52514e;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1140" height="250" as="geometry"/></mxCell>
      <mxCell id="g2" value="Query: runs on every search" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#8a8a86;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#52514e;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1140" height="490" as="geometry"/></mxCell>
      <mxCell id="upload" value="&lt;b&gt;Admin upload&lt;/b&gt;&lt;br&gt;project text, narration,&lt;br&gt;PDF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f4f1;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="extract" value="&lt;b&gt;Text extraction&lt;/b&gt;&lt;br&gt;pypdf, per page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="70" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="chunk" value="&lt;b&gt;Passage chunking&lt;/b&gt;&lt;br&gt;whole sentences,&lt;br&gt;40 words, 1 overlap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="150" height="64" as="geometry"/></mxCell>
      <mxCell id="embed" value="&lt;b&gt;Sentence model&lt;/b&gt;&lt;br&gt;bge-small-en-v1.5,&lt;br&gt;ONNX, 384 dimensions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="70" width="165" height="64" as="geometry"/></mxCell>
      <mxCell id="fold" value="&lt;b&gt;Keyword text&lt;/b&gt;&lt;br&gt;accent folding,&lt;br&gt;field weights A to D" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="150" height="60" as="geometry"/></mxCell>
      <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;search_chunks:&lt;br&gt;vector(384), HNSW&lt;br&gt;projects.search_tsv:&lt;br&gt;tsvector, GIN" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#e9f7f1;strokeColor=#1baf7a;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="95" width="180" height="135" as="geometry"/></mxCell>
      <mxCell id="ui" value="&lt;b&gt;3D globe site&lt;/b&gt;&lt;br&gt;search box:&lt;br&gt;Keywords / By meaning" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f4f1;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="140" height="64" as="geometry"/></mxCell>
      <mxCell id="dback" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;reachable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff6e0;strokeColor=#c98a00;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="432" width="120" height="80" as="geometry"/></mxCell>
      <mxCell id="api" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;GET /api/projects/search&lt;br&gt;mode, limit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="440" width="165" height="64" as="geometry"/></mxCell>
      <mxCell id="qembed" value="&lt;b&gt;Embed the query&lt;/b&gt;&lt;br&gt;same sentence model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="330" width="160" height="60" as="geometry"/></mxCell>
      <mxCell id="dmodel" value="&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;loaded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff6e0;strokeColor=#c98a00;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775" y="320" width="120" height="80" as="geometry"/></mxCell>
      <mxCell id="vec" value="&lt;b&gt;Vector search&lt;/b&gt;&lt;br&gt;pgvector HNSW, cosine&lt;br&gt;(numpy without pgvector)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="190" height="60" as="geometry"/></mxCell>
      <mxCell id="cut" value="&lt;b&gt;Relevance cut-off&lt;/b&gt;&lt;br&gt;at least 0.575 and within&lt;br&gt;95% of the top score" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="430" width="190" height="60" as="geometry"/></mxCell>
      <mxCell id="fallback" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;skip meaning, return&lt;br&gt;keyword results only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff6e0;strokeColor=#c98a00;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="428" width="130" height="64" as="geometry"/></mxCell>
      <mxCell id="fts" value="&lt;b&gt;Keyword search&lt;/b&gt;&lt;br&gt;to_tsquery, stems and&lt;br&gt;prefixes, ts_rank_cd" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="540" width="150" height="64" as="geometry"/></mxCell>
      <mxCell id="rrf" value="&lt;b&gt;Hybrid fusion&lt;/b&gt;&lt;br&gt;reciprocal rank fusion, k = 60:&lt;br&gt;meaning + every-word matches" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdece4;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="190" height="64" as="geometry"/></mxCell>
      <mxCell id="browser" value="&lt;b&gt;Search in the browser (the live site, no backend)&lt;/b&gt;&lt;br&gt;Transformers.js runs the same model (bge-small-en-v1.5, q8): cosine over every passage,&lt;br&gt;fused with the page&amp;#x27;s keyword ranking (RRF, k = 60).&lt;br&gt;If the model cannot run: the keyword ranking alone, and the site says so." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff6e0;strokeColor=#c98a00;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="650" height="84" as="geometry"/></mxCell>
      <mxCell id="out" value="&lt;b&gt;Ranked projects&lt;/b&gt;&lt;br&gt;passage, similarity,&lt;br&gt;matched_by, mode_used" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f7f1;strokeColor=#1baf7a;fontColor=#0b0b0b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="670" width="190" height="84" as="geometry"/></mxCell>
      <mxCell id="e0" value="" style="html=1;rounded=0;strokeColor=#3d3d3a;fontSize=10;fontColor=#52514e;endArrow=classic;" edge="1" parent="1" source="upload" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
