<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Backend database schema" id="backend-schema"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="authors" value="&lt;b&gt;authors&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;UNIQUE  name&lt;br/&gt;profession, role, affiliation&lt;br/&gt;website, google_scholar&lt;br/&gt;researchgate, academia&lt;br/&gt;region_lat, region_lng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="45.0" y="279.0" width="270.0" height="189.0" as="geometry" /></mxCell><mxCell id="projects" value="&lt;b&gt;projects&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;FK  author_id → authors.id&lt;br/&gt;title, description, category&lt;br/&gt;location_name, lat, lng, date&lt;br/&gt;verified, keywords, sdgs&lt;br/&gt;images, captions, summary&lt;br/&gt;original_language, title_original&lt;br/&gt;description_original, translation_reviewed_by&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="450.0" y="270.0" width="324.0" height="229.49999999999997" as="geometry" /></mxCell><mxCell id="documents" value="&lt;b&gt;documents&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;FK  project_id → projects.id&lt;br/&gt;title, filename, path&lt;br/&gt;size_bytes, pages, text&lt;br/&gt;summary, keywords, uploaded_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="900.0" y="360.0" width="270.0" height="180.0" as="geometry" /></mxCell><mxCell id="search_chunks" value="&lt;b&gt;search_chunks&lt;/b&gt;&lt;hr/&gt;PK  id&lt;br/&gt;FK  project_id → projects.id&lt;br/&gt;FK nullable  document_id → documents.id&lt;br/&gt;source, position, text&lt;br/&gt;embedding (JSON float list), model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7fb;strokeColor=#385b78;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="450.0" y="22.5" width="360.0" height="180.0" as="geometry" /></mxCell><mxCell id="e0" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="authors" target="projects"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="projects" target="documents"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="projects" target="search_chunks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="0/1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#59636e;" edge="1" parent="1" source="documents" target="search_chunks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br/&gt;• Only four ORM tables are defined in backend/inference/app/db/models.py: authors, projects, documents, search_chunks.&lt;br/&gt;• PostgreSQL init adds generated projects.location (PostGIS), projects.search_tsv (tsvector), and optional search_chunks.embedding_vec vector(384) plus indexes.&lt;br/&gt;• The ORM stores embedding as JSON list[float] for SQLite compatibility. Backend DATABASE_URL defaults to SQLite; PostgreSQL is configured through environment settings.&lt;br/&gt;• No users, messages, or contacts tables are defined in these models." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#b69b4b;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1120" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>