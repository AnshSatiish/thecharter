<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="backend-database-erd" name="Backend PostgreSQL ERD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="table_0" value="&lt;b&gt;authors&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;name   &lt;font color='#667085' size='1'&gt;UNIQUE, INDEXED&lt;/font&gt;&lt;br&gt;profession&lt;br&gt;role   &lt;font color='#667085' size='1'&gt;CHECK: academic / journalist&lt;/font&gt;&lt;br&gt;affiliation, website&lt;br&gt;google_scholar, researchgate&lt;br&gt;academia, region_lat, region_lng" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="300" height="227" as="geometry" /></mxCell><mxCell id="table_1" value="&lt;b&gt;projects&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;title, description&lt;br&gt;category   &lt;font color='#667085' size='1'&gt;CHECK: wildlife / anthropology / urban / border / news&lt;/font&gt;&lt;br&gt;location_name, lat, lng   &lt;font color='#667085' size='1'&gt;lat/lng range check&lt;/font&gt;&lt;br&gt;date, verified&lt;br&gt;keywords, sdgs, images, captions   &lt;font color='#667085' size='1'&gt;JSON&lt;/font&gt;&lt;br&gt;summary, original_language&lt;br&gt;title_original, description_original&lt;br&gt;translation_reviewed_by&lt;br&gt;created_at   &lt;font color='#667085' size='1'&gt;timezone&lt;/font&gt;&lt;br&gt;author_id   &lt;font color='#667085' size='1'&gt;FK → authors.id&lt;/font&gt;&lt;br&gt;search_tsv   &lt;font color='#667085' size='1'&gt;PostgreSQL search field; GIN index (if configured)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="500" y="50" width="300" height="352" as="geometry" /></mxCell><mxCell id="table_2" value="&lt;b&gt;documents&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;project_id   &lt;font color='#667085' size='1'&gt;FK → projects.id, ON DELETE CASCADE&lt;/font&gt;&lt;br&gt;title, filename, path&lt;br&gt;size_bytes, pages&lt;br&gt;text   &lt;font color='#667085' size='1'&gt;deferred&lt;/font&gt;&lt;br&gt;summary&lt;br&gt;keywords   &lt;font color='#667085' size='1'&gt;JSON&lt;/font&gt;&lt;br&gt;uploaded_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="980" y="60" width="300" height="252" as="geometry" /></mxCell><mxCell id="table_3" value="&lt;b&gt;search_chunks&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;project_id   &lt;font color='#667085' size='1'&gt;FK → projects.id, ON DELETE CASCADE&lt;/font&gt;&lt;br&gt;document_id   &lt;font color='#667085' size='1'&gt;nullable FK → documents.id, ON DELETE CASCADE&lt;/font&gt;&lt;br&gt;source, position&lt;br&gt;text&lt;br&gt;embedding   &lt;font color='#667085' size='1'&gt;JSON list[float] in ORM&lt;/font&gt;&lt;br&gt;embedding_vec   &lt;font color='#667085' size='1'&gt;pgvector vector(384), if enabled at DB startup&lt;/font&gt;&lt;br&gt;model" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="500" y="410" width="300" height="252" as="geometry" /></mxCell><mxCell id="rel_0" value="1 : N   author_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_0" target="table_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_1" value="1 : N   project_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_1" target="table_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_2" value="1 : N   project_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_1" target="table_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_3" value="1 : N   nullable document_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_2" target="table_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_0" value="ORM: embedding = JSON list[float]. PostgreSQL embedding_vec vector(384) is conditional on startup configuration." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="760" width="1320" height="28" as="geometry" /></mxCell><mxCell id="note_1" value="projects.search_tsv / GIN are search implementation details; verify active DB setup." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="792" width="1320" height="28" as="geometry" /></mxCell><mxCell id="note_2" value="search_chunks.document_id is nullable; ON DELETE CASCADE where the FK exists." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="824" width="1320" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>