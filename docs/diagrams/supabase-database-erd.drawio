<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="supabase-database-erd" name="Supabase PostgreSQL ERD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="table_0" value="&lt;b&gt;auth.users (external Supabase Auth)&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="80" width="300" height="77" as="geometry" /></mxCell><mxCell id="table_1" value="&lt;b&gt;admins&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;user_id   &lt;font color='#667085' size='1'&gt;PK, FK → auth.users.id&lt;/font&gt;&lt;br&gt;added_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="430" y="80" width="300" height="102" as="geometry" /></mxCell><mxCell id="table_2" value="&lt;b&gt;projects&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;title, description&lt;br&gt;category, location_name&lt;br&gt;lat, lng, date&lt;br&gt;keywords, sdgs   &lt;font color='#667085' size='1'&gt;text[]&lt;/font&gt;&lt;br&gt;images, captions   &lt;font color='#667085' size='1'&gt;text[]&lt;/font&gt;&lt;br&gt;summary&lt;br&gt;author_name, affiliation   &lt;font color='#667085' size='1'&gt;flattened author fields&lt;/font&gt;&lt;br&gt;profession, role, website   &lt;font color='#667085' size='1'&gt;flattened author fields&lt;/font&gt;&lt;br&gt;document_url, document_name   &lt;font color='#667085' size='1'&gt;Supabase Storage reference / metadata&lt;/font&gt;&lt;br&gt;document_size&lt;br&gt;verified&lt;br&gt;created_at&lt;br&gt;created_by   &lt;font color='#667085' size='1'&gt;FK → auth.users.id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="900" y="70" width="300" height="402" as="geometry" /></mxCell><mxCell id="table_3" value="&lt;b&gt;events&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;title, kind&lt;br&gt;starts_on, ends_on&lt;br&gt;location_name, online&lt;br&gt;url, description&lt;br&gt;created_at&lt;br&gt;created_by   &lt;font color='#667085' size='1'&gt;FK → auth.users.id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="430" y="450" width="300" height="227" as="geometry" /></mxCell><mxCell id="table_4" value="&lt;b&gt;sponsors&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;id   &lt;font color='#667085' size='1'&gt;PK&lt;/font&gt;&lt;br&gt;name, tier, url&lt;br&gt;logo_url, blurb&lt;br&gt;sort, created_at&lt;br&gt;created_by   &lt;font color='#667085' size='1'&gt;FK → auth.users.id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#344054;fontColor=#101828;fontSize=11;" parent="1" vertex="1"><mxGeometry x="900" y="450" width="300" height="177" as="geometry" /></mxCell><mxCell id="rel_0" value="1 : 0..1   user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_0" target="table_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_1" value="1 : N   created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_0" target="table_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_2" value="1 : N   created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_0" target="table_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_3" value="1 : N   created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=10;" parent="1" edge="1" source="table_0" target="table_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_0" value="RLS/admin access is a policy relationship, not an FK from admins to content tables." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="760" width="1320" height="28" as="geometry" /></mxCell><mxCell id="note_1" value="project-files is Supabase Storage, not a relational table. auth.users is managed by Supabase Auth." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="792" width="1320" height="28" as="geometry" /></mxCell><mxCell id="note_2" value="Supabase projects flattens author attributes; backend authors is a separate table in another PostgreSQL database." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475467;" parent="1" vertex="1"><mxGeometry x="30" y="824" width="1320" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>